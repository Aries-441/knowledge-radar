# Dedicated existing host directory for compose.yaml / compose.feishu.capture.yaml.
# Base compose.feishu.yaml does not mount it. Do not mount the entire knowledge base.
KNOWLEDGE_RADAR_ARCHIVE_DIR_HOST=D:/Desktop/MyKnowledgeBase/Private/Inbox
# For local serve-feishu only, opt in explicitly (Docker overrides this):
# KNOWLEDGE_RADAR_ARCHIVE_DIR=D:/Desktop/MyKnowledgeBase/Private/Inbox

# pi-ai model reference. Set the matching provider credential below.
KNOWLEDGE_RADAR_MODEL=deepseek/deepseek-v4-flash
DEEPSEEK_API_KEY=

# Alternate OpenAI configuration:
# KNOWLEDGE_RADAR_MODEL=openai/gpt-4.1-mini
# OPENAI_API_KEY=

# Feishu private text chat (self-built app; do not commit real values).
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TENANT_KEY=
FEISHU_ALLOWED_OPEN_ID=
# Local run only; compose.feishu.yaml overrides this with its named-volume path.
KNOWLEDGE_RADAR_STATE_PATH=./data/radar.db

# Optional RSS/Atom ingestion. Set the host path and add compose.feeds.yaml.
# KNOWLEDGE_RADAR_FEEDS_CONFIG_HOST=D:/Desktop/knowledge-radar/feeds.yaml
# The YAML can enable a daily digest with digest.enabled: true. The bot needs
# the Feishu im:message:send_as_bot permission to send it proactively.
